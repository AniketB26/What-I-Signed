# ─────────────────────────────────────────────────────────────
#  What I Signed — environment template
#
#  Local dev (npm run dev):   cp .env.example server/.env
#  Docker (docker compose):   cp .env.example .env
#
#  Docker Compose reads variable substitutions from the .env file in the
#  repository root, so the Docker path needs it there rather than in server/.
#  Never commit either file — both are covered by .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Server ──
NODE_ENV=development
PORT=5000

# Origin(s) allowed to call the API with credentials. Comma-separate to allow
# more than one (e.g. production plus a preview deployment).
# Local dev: http://localhost:5173   Docker: http://localhost:8080
CLIENT_URL=http://localhost:5173

# ── MongoDB ──
# Local dev: an Atlas SRV string, or mongodb://localhost:27017/whatisigned
# Docker: leave this alone — docker-compose.yml builds the URI from the
#         MONGO_* values below and points the API at the mongo container.
MONGODB_URI=mongodb://localhost:27017/whatisigned

# Escape hatch for the Node 22 + Atlas + Windows certificate issue. This
# disables TLS certificate verification — only enable it locally, never in
# production.
MONGODB_TLS_ALLOW_INVALID_CERTS=false

# ── MongoDB container (docker compose only) ──
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change_this_password
MONGO_DB=whatisigned

# Host port for mongosh/Compass access. Defaults to 27018 rather than 27017 so
# it doesn't collide with a MongoDB already installed on your machine.
MONGO_PORT=27018

# Host port the web UI is published on.
CLIENT_PORT=8080

# ── JWT ──
# Generate each with:  openssl rand -hex 32
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_64_char_random_hex_string

# ── Cookies ──
# Set COOKIE_SAMESITE=None (implies Secure) only when the API and the SPA are
# on different sites, e.g. a Vercel front end calling a Render API. When they
# share an origin — as they do behind the bundled nginx — leave it as Lax.
COOKIE_SAMESITE=Lax
# COOKIE_DOMAIN=.yourdomain.com

# Proxy hops in front of the API, used for X-Forwarded-For parsing.
TRUST_PROXY_HOPS=1

# ── Pinecone (vector store) ──
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=wdis-documents

# ── Cloudinary (file storage) ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Google AI (Gemini — LLM + embeddings) ──
GEMINI_API_KEY=your_gemini_api_key

# ── Groq (fallback LLM) ──
GROQ_API_KEY=your_groq_api_key

# ── SendGrid (email alerts, optional) ──
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=alerts@example.com

# ── Google OAuth (not yet wired up) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Client build ──
# Leave empty so the SPA calls /api on its own origin (Vite proxy in dev,
# nginx proxy in Docker). Set it only if the API is on another origin.
VITE_API_URL=
